{
  "name": "flatline",
  "version": "0.5.0",
  "description": "Self-hosted voice for web apps: speech-to-text (whisper.cpp) and text-to-speech (Piper) on your own server, recording that stops on silence, and a cast of voice characters (Flatline, Kestrel, Iris, Ashford, Hoshi, Captain Calder and Nettle), each a sound, a tone and a set of lines. The audio never leaves your box.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REASON-labs/flatline.git"
  },
  "homepage": "https://github.com/REASON-labs/flatline#readme",
  "bugs": {
    "url": "https://github.com/REASON-labs/flatline/issues"
  },
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./cast": {
      "types": "./dist/cast/index.d.ts",
      "default": "./dist/cast/index.js"
    }
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test test/*.browser.mjs",
    "test:whisper": "npm run build && node --test test/whisper.integration.mjs",
    "test:voice": "npm run build && node --test test/voice.integration.mjs",
    "samples": "node tools/cast-samples.mjs"
  },
  "keywords": [
    "mediarecorder",
    "piper",
    "privacy",
    "self-hosted",
    "speech-to-text",
    "speechsynthesis",
    "text-to-speech",
    "tts",
    "voice",
    "whisper",
    "whisper.cpp"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
