{
  "name": "flatline",
  "version": "0.2.2",
  "description": "Self-hosted voice for web apps: speech-to-text (whisper.cpp) and text-to-speech (Piper) on your own server, recording that stops on silence, and Dixie, a voice that reads text aloud. The audio never leaves your box.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test test/*.browser.mjs",
    "test:whisper": "npm run build && node --test test/whisper.integration.mjs",
    "test:voice": "npm run build && node --test test/voice.integration.mjs"
  },
  "keywords": [
    "mediarecorder",
    "piper",
    "privacy",
    "self-hosted",
    "speech-to-text",
    "speechsynthesis",
    "text-to-speech",
    "tts",
    "voice",
    "whisper",
    "whisper.cpp"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
